# =====================================================================
# Variables de Docker Compose (docker-compose.yml). SIN valores sensibles.
#
#   cp .env.example .env        (en Windows: copy .env.example .env)
#
# El .env va en la RAIZ del repo y NUNCA se sube a Git (esta en .gitignore).
# Todas las variables tienen valor por defecto en docker-compose.yml: si no existe
# el .env, la solucion levanta igual con estos mismos valores.
#
# Para ejecutar un servicio LOCAL con `npm start` (sin Docker) NO se usa este archivo:
# cada servicio tiene su propio services/<servicio>/.env.example.
# =====================================================================

# Prefijo de las imagenes: <prefijo>/<servicio>:tp6 (ej. grupo2/usuarios-service:tp6)
IMAGE_PREFIX=grupo2

LOG_LEVEL=info

# ---------- Puertos publicados hacia tu PC (el interno de cada contenedor es siempre 3000) ----------
# Cambialos si ya tenes algo escuchando en 3001/3002/3003 (por ejemplo un servicio corriendo local).
USUARIOS_HOST_PORT=3001
EVENTOS_HOST_PORT=3002
ENTRADAS_HOST_PORT=3003

# ---------- TP7: JWT (se entrega a los tres servicios) ----------
# OBLIGATORIO y SIN valor por defecto: docker compose no arranca si falta. Minimo 32 caracteres. Generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vida del token: 900 (segundos), 30m, 1h, 2d. Nunca hay tokens sin vencimiento.
JWT_EXPIRES_IN=1h

# ---------- Credencial técnica Entradas -> Eventos ----------
# OBLIGATORIA y distinta de JWT_SECRET. Solo la reciben entradas-service y eventos-service.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
EVENTOS_SERVICE_TOKEN_SECRET=

# ---------- usuarios-service: hash de contraseñas y seed (datos de prueba) ----------
# Costo de bcrypt. Mas alto = mas lento y mas seguro.
BCRYPT_ROUNDS=12
# Contraseñas de los usuarios del seed (`docker compose exec -T usuarios-service npm run seed`).
# VALORES FICTICIOS: cambialos en tu .env (minimo 8 caracteres). Nunca uses contraseñas reales.
SEED_USER_PASSWORD=Cambiar-Esta-Clave-1
SEED_ADMIN_PASSWORD=Cambiar-Esta-Clave-Admin-1

# ---------- eventos-service ----------
# TTL del lock de aforo en Redis (ms)
LOCK_TTL_MS=5000

# ---------- entradas-service ----------
# Timeout de las llamadas HTTP a usuarios-service y eventos-service (ms)
REQUEST_TIMEOUT_MS=3000
MAX_ENTRADAS_POR_USUARIO=4
PLAZO_CANCELACION_HORAS=24

# ---------------------------------------------------------------------
# Lo siguiente NO se configura aca: lo fija el docker-compose.yml porque son direcciones
# internas de la red Docker y no deben cambiar entre integrantes.
#   MONGODB_URI            mongodb://<servicio>-db:27017/<base>
#   REDIS_URL              redis://redis:6379
#   USUARIOS_SERVICE_URL   http://usuarios-service:3000
#   EVENTOS_SERVICE_URL    http://eventos-service:3000
# ---------------------------------------------------------------------
