# =====================================================================
# Variables de entorno de ejemplo (SIN valores sensibles).
# Copiar a .env dentro de cada servicio y ajustar. NUNCA subir el .env real.
# Los puertos/URLs de abajo son una propuesta; se confirman en los TPs de
# implementación.
# =====================================================================

# ---------- Servicio Usuarios ----------
USUARIOS_PORT=3001
USUARIOS_MONGO_URI=mongodb://127.0.0.1:27017/usuarios_db

# ---------- Servicio Eventos ----------
EVENTOS_PORT=3002
EVENTOS_MONGO_URI=mongodb://127.0.0.1:27017/eventos_db
# Redis/Memurai: lo usa SOLO Eventos para el lock del aforo (herencia del TP2)
REDIS_URL=redis://127.0.0.1:6379
LOCK_TTL_MS=5000

# ---------- Servicio Entradas ----------
ENTRADAS_PORT=3003
ENTRADAS_MONGO_URI=mongodb://127.0.0.1:27017/entradas_db
MAX_ENTRADAS_POR_USUARIO=4
PLAZO_CANCELACION_HORAS=24

# ---------- URLs de otros servicios (las usa Entradas) ----------
USUARIOS_SERVICE_URL=http://localhost:3001
EVENTOS_SERVICE_URL=http://localhost:3002
SERVICE_TIMEOUT_MS=3000

# ---------- HTTPS de la API externa (heredado de TP2/TP3) ----------
# Rutas al certificado de desarrollo (autofirmado). No versionar los archivos.
SSL_KEY_PATH=certs/server.key
SSL_CERT_PATH=certs/server.cert

# ---------- Logging (heredado de TP3) ----------
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=5m
LOG_MAX_FILES=14d
