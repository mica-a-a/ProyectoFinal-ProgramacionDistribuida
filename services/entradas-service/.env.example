# Copiar a .env (dentro de services/entradas-service/). NUNCA subir el .env real.
# Valores para ejecución LOCAL. En Docker Compose se pisan desde docker-compose.yml.

SERVICE_NAME=entradas-service
PORT=3003
LOG_LEVEL=info

# Base propia del servicio (Compose: mongodb://entradas-db:27017/entradas)
MONGODB_URI=mongodb://127.0.0.1:27017/entradas

# URL base de usuarios-service (Compose: http://usuarios-service:3000)
USUARIOS_SERVICE_URL=http://localhost:3001

# URL base de eventos-service (Compose: http://eventos-service:3000)
EVENTOS_SERVICE_URL=http://localhost:3002

# Timeout de las llamadas HTTP a otros servicios
REQUEST_TIMEOUT_MS=3000

# Máximo de entradas por usuario por evento
MAX_ENTRADAS_POR_USUARIO=4

# Horas antes del evento hasta las que se puede cancelar
PLAZO_CANCELACION_HORAS=24
