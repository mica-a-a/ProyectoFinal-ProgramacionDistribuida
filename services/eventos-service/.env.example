# Copiar a .env (dentro de services/eventos-service/). NUNCA subir el .env real.
# Valores para ejecución LOCAL. En Docker Compose se pisan desde docker-compose.yml.

SERVICE_NAME=eventos-service
PORT=3002
LOG_LEVEL=info

# Base propia del servicio (Compose: mongodb://eventos-db:27017/eventos)
MONGODB_URI=mongodb://127.0.0.1:27017/eventos

# Redis para el lock por evento (Compose: redis://redis:6379)
REDIS_URL=redis://localhost:6379

# TTL del lock de aforo en milisegundos
LOCK_TTL_MS=5000
# ---------- TP7: JWT ----------
# OBLIGATORIO y con el MISMO valor que en usuarios-service: eventos-service verifica la firma de los tokens localmente
# (no consulta a Usuarios). Sin JWT_SECRET, los endpoints protegidos responden 500. En Docker Compose se define UNA vez
# en el .env de la raíz y se entrega a los tres servicios. Generar uno (mínimo 32 caracteres) con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Emisor esperado del token (claim "iss"). Default: usuarios-service
JWT_ISSUER=usuarios-service
