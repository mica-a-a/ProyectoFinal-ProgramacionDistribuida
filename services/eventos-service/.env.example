# Copiar a .env (dentro de services/eventos-service/). NUNCA subir el .env real.
# Valores para ejecución LOCAL. En Docker Compose se pisan desde docker-compose.yml.

SERVICE_NAME=eventos-service
PORT=3002
LOG_LEVEL=info

# Base propia del servicio (Compose: mongodb://eventos-db:27017/eventos)
MONGODB_URI=mongodb://127.0.0.1:27017/eventos

# Redis para el lock por evento (Compose: redis://redis:6379)
REDIS_URL=redis://localhost:6379

# TTL del lock de aforo en milisegundos
LOCK_TTL_MS=5000
