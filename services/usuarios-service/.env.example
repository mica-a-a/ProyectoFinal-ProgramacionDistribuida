# Copiar a .env (dentro de services/usuarios-service/). NUNCA subir el .env real.
# Valores para ejecución LOCAL. En Docker Compose se pisan desde docker-compose.yml.

SERVICE_NAME=usuarios-service
PORT=3001
LOG_LEVEL=info

# Base propia del servicio (Compose: mongodb://usuarios-db:27017/usuarios)
MONGODB_URI=mongodb://127.0.0.1:27017/usuarios

# Cada cuántos ms se reintenta la conexión inicial a Mongo si todavía no está lista
MONGODB_RETRY_MS=3000
# Cuánto espera el driver a encontrar Mongo antes de fallar (ms)
MONGODB_TIMEOUT_MS=3000

# ---------- TP7: credenciales ----------
# Costo de bcrypt (12 recomendado; mayor = más lento y más seguro)
BCRYPT_ROUNDS=12
# Solo para `npm run seed`. Valores FICTICIOS: cambialos en tu .env real.
SEED_USER_PASSWORD=Cambiar-Esta-Clave-1
SEED_ADMIN_PASSWORD=Cambiar-Esta-Clave-Admin-1
